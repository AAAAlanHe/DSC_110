--join the patients table and visits table together
SELECT p.Patient_id, visit_id, diagnosis, city
FROM patients p JOIN visits v
ON p.patient_id = v.patient_id;

--the average cost of visits per city
SELECT city, avg(cost)
FROM patients JOIN visits
ON p.patient_id = v.visit_id
GROUP BY city;
