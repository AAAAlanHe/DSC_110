--create patients table
CREATE TABLE Patients (
    patient_id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    age INTEGER,
    gender TEXT,
    city TEXT
);

--insert sample data into patients table
INSERT INTO Patients (patient_id, name, age, gender, city) VALUES
(1, 'John Doe', 45, 'M', 'Boston'),
(2, 'Jane Smith', 32, 'F', 'Cambridge'),
(3, 'Mike Johnson', 58, 'M', 'Boston'),
(4, 'Sarah Williams', 41, 'F', 'Somerville'),
(5, 'David Brown', 29, 'M', 'Boston'),
(6, 'Emily Davis', 67, 'F', 'Cambridge');

--the information of patients, including patient_id, name, age, gender, city
SELECT * FROM patients;

--select the female patients
SELECT * FROM patients
Where gender = 'F';

--the name and their age of the patients
SELECT Name, Age
FROM patients;

--select the patients that above 40 years old
SELECT * FROM Patients
WHERE Age > 40;

--the number of patients
SELECT COUNT(*) FROM Patients;

--which cities do the patients comes from
SELECT COUNT(DISTINCT city) FROM Patients;
SELECT DISTINCT city FROM Patients;

--the patients' average age, minimun age, maximun age and the sum of their age
SELECT avg(age) FROM Patients;
SELECT min(age) FROM Patients;
SELECT max(age) FROM Patients;
SELECT sum(age) FROM Patients;

--count the average age of each gender
SELECT gender, avg(age) Avg_age
FROM Patients
GROUP BY gender
GROUP BY 2;

--the minimun age for patients from each city
SELECT min(age), city FROM Patients
GROUP by city;

--the maximun age for patients from each city
SELECT city, max(age) Max_age
FROM Patients
GROUP BY city
GROUP BY 1 DESC;

-- create visits table
CREATE TABLE Visits (
    visit_id INTEGER PRIMARY KEY,
    patient_id INTEGER,
    visit_date TEXT,
    diagnosis TEXT,
    cost REAL,
    FOREIGN KEY (patient_id) REFERENCES Patients(patient_id)
);

